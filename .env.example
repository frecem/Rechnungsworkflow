# Nur Bootstrap-Infrastruktur. Alle Benutzerdaten (IMAP/SMTP/Weiterleitungs-Adressen/
# Kategorien/Login-Passwort) werden nach dem Start über die Einstellungen-Seite
# in der Datenbank verwaltet (Ersteinrichtung unter /setup).

DATABASE_URL=sqlite:///./storage/db.sqlite3
STORAGE_DIR=./storage/invoices

# Zufälligen, langen String erzeugen (z.B. `python3 -c "import secrets; print(secrets.token_hex(32))"`)
# und hier eintragen. Schützt die Login-Session; bei Änderung werden alle angemeldeten
# Sitzungen ungültig.
SESSION_SECRET_KEY=change-me-please-a-long-random-string
