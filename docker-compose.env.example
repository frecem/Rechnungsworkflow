# Variablen für docker-compose.yml selbst (die ${...}-Platzhalter darin).
#
# WICHTIG: Diese Datei muss EXAKT ".env" heißen (nicht "docker-compose.env"!)
# und im selben Verzeichnis wie docker-compose.yml liegen - nur unter diesem
# Namen liest docker compose sie automatisch ein:
#   cp docker-compose.env.example .env
# Nicht zu verwechseln mit der App-eigenen .env, die unter ${DATA_PATH}/.env
# liegt (separates Verzeichnis, separater Zweck: nur SESSION_SECRET_KEY) und
# in den Container gemountet wird.

# Host-Verzeichnis für alles Persistente (DB + Belegdateien) UND die App-.env.
# Muss vor dem ersten Start existieren, siehe README -> "Docker-Betrieb".
DATA_PATH=/var/docker/rechnungsworkflow

# Host-Port, unter dem die App erreichbar ist - trägst du in Traefiks
# dynamic.yaml als Backend-URL ein (z.B. http://<Host-IP>:8000).
APP_PORT=8000

# IP(s), von denen die App X-Forwarded-*-Header vertraut (Traefik-IP aus Sicht
# des Containers). "*" ist für ein Heimnetz ohne direkten Internetzugriff auf
# diesen Port ein vertretbarer Standard - siehe README für die sicherere,
# auf die konkrete Traefik-IP eingeschränkte Variante.
FORWARDED_ALLOW_IPS=*

# Zeitzone im Container - bestimmt, wann die taeglichen Erinnerungs-Cronjobs
# tatsaechlich feuern (07/08/09 Uhr lokale Zeit, siehe app/main.py). Ohne
# diese Variable laeuft der Container in UTC (2h Versatz im Sommer).
TZ=Europe/Berlin
